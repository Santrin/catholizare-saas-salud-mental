# ─────────────────────────────────────────────────────────────
# Catholizare OS — variables de entorno
#
# 1. Copia este archivo como `.env.local` para desarrollo local:
#    cp .env.example .env.local
# 2. Rellena los valores reales (nunca commitees `.env.local`).
# 3. En Vercel/staging/producción: configúralas en el dashboard,
#    NO en este archivo.
# ─────────────────────────────────────────────────────────────

# Entorno
NODE_ENV=development

# URL pública del sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (proyecto: local, staging o producción) ───
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Google OAuth (se configura en Supabase Auth, no se lee por Next.js) ───
# Obtener en: https://console.cloud.google.com/apis/credentials
# Registrar redirect URI: https://<tu-proyecto>.supabase.co/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

# ─── Resend (email transaccional) ───
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=no-reply@catholizare.com

# ─── Catholizare Care (WordPress REST API) ───
CATHOLIZARE_CARE_API_URL=https://catholizare.com/wp-json/wp/v2

# ─── Webhook Amelia (alta de pacientes desde Care) ───
# Generar con: openssl rand -hex 32
AMELIA_WEBHOOK_SECRET=generate-a-random-secret

# ─── Stripe (Fase 2) ───
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Zoom (Fase 2) ───
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=

# ─── Facturapi (Fase 2) ───
# FACTURAPI_KEY=
